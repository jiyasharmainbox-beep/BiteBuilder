# Copy this file to .env and fill in real values before running

# Required: generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Base URL of the deployed app (used for password reset links etc.)
APP_BASE_URL=http://localhost:8000

# Spoonacular API key (used for recipe image classification)
# Get a free key at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your-spoonacular-api-key-here

# Google Gemini API key (no longer used — kept for reference)
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key (used for ingredient image analysis via gpt-4o-mini)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional tuning
MAX_UPLOAD_SIZE_BYTES=5242880
POSTS_PER_PAGE=10
